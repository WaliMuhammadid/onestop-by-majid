# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_..."
# Project URL from Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
# Anon public key (safe for client side, subject to Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# Service role secret (NEVER expose to client; server actions only)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ============================================================================
# ADMIN & SECURITY CONFIGURATION
# ============================================================================
# Secret URL path for the administrative portal (No links exist in client UI)
ADMIN_SECRET_PATH="/control-x7k2"
# Default administrative identity
ADMIN_DEFAULT_EMAIL="admin@aura-studio.com"

# ============================================================================
# PAYMENT INTEGRATIONS (OPTIONAL)
# ============================================================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
